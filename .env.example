# Copy to .env for your private local testing; .env is never committed.
EDGEWATCH_MODE=demo
EDGEWATCH_HOST=127.0.0.1
EDGEWATCH_PORT=8765
EDGEWATCH_DB=./data/edgewatch.sqlite3
WARNING_C=35
CRITICAL_C=45
RECOVERY_MARGIN_C=2
STALE_SECONDS=18
# Optional real ChirpStack integration. Requires MQTT mode and authorization.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=application/+/device/+/event/up
MQTT_TLS=false
# MQTT_USERNAME=
# MQTT_PASSWORD=
